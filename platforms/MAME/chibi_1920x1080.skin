# MAMEly Skin File platforms/MAME/chibi_1920x1080.skin
# Chibi Kawaii Gamer 1920x1080 skin generated by Antigravity

# skin image
backgroundImage = background_chibi_1920x1080.png

# skinnable colors in the script
defaultFontForegroundColor = FF77B4
defaultHighlightFontForegroundColor = 00F0FF
defaultRomNameDisplayLineShadowColor = 2A0033
defaultRomNameDisplayLineHighlightShadowColor = 004455
defaultRomNameDisplayBoxShadowColor = 2A0033
defaultRomNameDisplayBoxColor = FFE600
defaultTitleBarColor = FF77B4
defaultTitleBarShadowColor = 2A0033
defaultRomCountColor = 00F0FF
defaultRomCountShadowColor = 003344
defaultMessageColor = FFE600
defaultGameSetBarColor = FF77B4
defaultGameSetBarShadowColor = 2A0033
defaultRomGenreColor = 00F0FF
defaultRomGenreShadowColor = 003344
defaultRomFileNameColor = FF77B4
defaultRomFileNameShadowColor = 2A0033

# strokes / shadows
romCountShadow = True
romGenreShadow = True
romFileNameShadow = True
genreSetShadow = True
romListDisplayHighlightShadow = True
romListDisplayShadow = True
messageShadow = True

# show or hide sections
genreSetShow = True
romGenreShow = True
romCountShow = True
romFileNameDisplayBoxShow = True
romSnapShow = True

# area for scrolling list of games (Main Left Screen)
romListDisplayAreaX1 = 180
romListDisplayAreaY1 = 200
romListDisplayAreaX2 = 1048
romListDisplayAreaY2 = 820
romListDisplayFont = Continuum-Bold-Regular.ttf
romListDisplayFontSize = 28
romListDisplaySpacing = 34
romListDisplayTruncateLen = 45
romListDisplayAlign = left

# area for genre of current rom and rating, and also messages (Bottom of Main Left Screen)
romGenreX1 = 180
romGenreY1 = 830
romGenreX2 = 1048
romGenreY2 = 910
romGenreFont = Continuum-Bold-Regular.ttf
romGenreFontSize = 24
romGenreTruncateLen = 50
romGenreAlign = center
messageFont = Continuum-Bold-Regular.ttf
messageFontSize = 32
messageTime = 1
messageTruncateLen = 40
messageAlign = center

# area for genre set / title bar (Top of Main Left Screen)
genreSetX1 = 180
genreSetY1 = 120
genreSetX2 = 1048
genreSetY2 = 190
genreSetFont = Continuum-Bold-Regular.ttf
genreSetFontSize = 30
genreSetTruncateLen = 45
genreSetAlign = center

# area for rom snap image (Middle Right Window)
romSnapX1 = 1255
romSnapY1 = 285
romSnapX2 = 1766
romSnapY2 = 388

# area for # of ### (Top Right Window)
romCountX1 = 1255
romCountY1 = 100
romCountX2 = 1766
romCountY2 = 208
romCountFont = Continuum-Bold-Regular.ttf
romCountFontSize = 32
romCountTruncateLen = 16
romCountAlign = center

# area for file name of current rom (Bottom Right below snap)
