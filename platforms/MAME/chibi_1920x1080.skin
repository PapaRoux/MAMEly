romFileNameDisplayBoxY1 = 410
romFileNameDisplayBoxX2 = 1766
romFileNameDisplayBoxY2 = 490
romFileNameDisplayBoxFont = Continuum-Bold-Regular.ttf
romFileNameDisplayBoxFontSize = 32
