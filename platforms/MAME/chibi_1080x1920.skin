# MAMEly Skin File platforms/MAME/chibi_1080x1920.skin
# Chibi Kawaii Gamer 1080x1920 Portrait skin generated by Antigravity

# skin image
backgroundImage = background_chibi_1080x1920.png

# skinnable colors in the script
defaultFontForegroundColor = FF77B4
defaultHighlightFontForegroundColor = 00F0FF
defaultRomNameDisplayLineShadowColor = 2A0033
defaultRomNameDisplayLineHighlightShadowColor = 004455
defaultRomNameDisplayBoxShadowColor = 2A0033
defaultRomNameDisplayBoxColor = FFE600
defaultTitleBarColor = FF77B4
defaultTitleBarShadowColor = 2A0033
defaultRomCountColor = 00F0FF
defaultRomCountShadowColor = 003344
defaultMessageColor = FFE600
defaultGameSetBarColor = FF77B4
defaultGameSetBarShadowColor = 2A0033
defaultRomGenreColor = 00F0FF
defaultRomGenreShadowColor = 003344
defaultRomFileNameColor = FF77B4
defaultRomFileNameShadowColor = 2A0033

# strokes / shadows
romCountShadow = True
romGenreShadow = True
romFileNameShadow = True
genreSetShadow = True
romListDisplayHighlightShadow = True
romListDisplayShadow = True
messageShadow = True

# show or hide sections
genreSetShow = True
romGenreShow = True
romCountShow = True
romFileNameDisplayBoxShow = True
romSnapShow = True

# area for scrolling list of games (Middle Left Box)
romListDisplayAreaX1 = 190
romListDisplayAreaY1 = 1060
romListDisplayAreaY2 = 1290
romListDisplayAreaX2 = 570
romListDisplayFont = Continuum-Bold-Regular.ttf
romListDisplayFontSize = 22
romListDisplaySpacing = 28
romListDisplayTruncateLen = 22
romListDisplayAlign = center

# area for genre of current rom and rating, and also messages (Bottom Left Box - Top Half)
romGenreX1 = 190
romGenreY1 = 1425
romGenreX2 = 570
romGenreY2 = 1560
romGenreFont = Continuum-Bold-Regular.ttf
romGenreFontSize = 22
romGenreTruncateLen = 24
romGenreAlign = center
messageFont = Continuum-Bold-Regular.ttf
messageFontSize = 26
messageTime = 1
messageTruncateLen = 20
messageAlign = center

# area for genre set / title bar (Above Middle Box)
genreSetX1 = 190
genreSetY1 = 1005
genreSetX2 = 570
genreSetY2 = 1055
genreSetFont = Continuum-Bold-Regular.ttf
genreSetFontSize = 24
genreSetTruncateLen = 22
genreSetAlign = center

# area for rom snap image (Top Large Screen)
romSnapX1 = 210
romSnapY1 = 250
romSnapX2 = 870
romSnapY2 = 810

# area for # of ### (Above Top Screen)
romCountX1 = 210
romCountY1 = 175
romCountX2 = 870
romCountY2 = 235
romCountFont = Continuum-Bold-Regular.ttf
romCountFontSize = 28
romCountTruncateLen = 16
romCountAlign = center

# area for file name of current rom (Bottom Left Box - Bottom Half)
romFileNameDisplayBoxX1 = 190
romFileNameDisplayBoxY1 = 1570
romFileNameDisplayBoxX2 = 570
romFileNameDisplayBoxY2 = 1720
romFileNameDisplayBoxFont = Continuum-Bold-Regular.ttf
romFileNameDisplayBoxFontSize = 26
romFileNameDisplayBoxTruncateLen = 18
romFileNameDisplayBoxAlign = center
